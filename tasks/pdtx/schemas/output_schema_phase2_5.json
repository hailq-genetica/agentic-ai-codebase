{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PD-TxBench Phase 2.5 deliverable (result.json)",
  "description": "Schema for the result.json a Phase 2.5 (small-molecule) task writes. Phase 2.5 deliverables are keyed by task_family rather than therapy category (every task is a small molecule). Validation enforces the structural contract only: the required keys must be present, any decision field must be a valid enum value, and confidence must be a 0-1 number. Descriptive/content fields accept any JSON shape (string, object, or array) so a model that returns a richer structure than a plain string still validates. Validate against the definition matching the task's task_family.",
  "definitions": {
    "_go_no_go": {
      "type": "string",
      "enum": ["Go", "No-Go", "Conditional Go"]
    },
    "_claim_classification": {
      "type": "string",
      "enum": ["Supported", "Partially Supported", "Unsupported", "Contradicted", "Insufficient Evidence"]
    },
    "_confidence": {"type": "number", "minimum": 0, "maximum": 1},

    "target_mechanism_reasoning": {
      "type": "object",
      "required": ["mechanism_explanation", "target_relevance", "key_uncertainties", "overclaiming_check", "confidence"],
      "properties": {
        "confidence": {"$ref": "#/definitions/_confidence"}
      }
    },
    "evidence_verification": {
      "type": "object",
      "required": ["claim_classification", "evidence_summary", "evidence_level", "main_uncertainty", "confidence"],
      "properties": {
        "claim_classification": {"$ref": "#/definitions/_claim_classification"},
        "confidence": {"$ref": "#/definitions/_confidence"}
      }
    },
    "candidate_smiles_evaluation": {
      "type": "object",
      "required": ["candidate_summary", "mechanism_hypothesis", "cns_drug_likeness", "admet_risks", "go_no_go", "main_reasons", "next_experiment", "confidence"],
      "properties": {
        "go_no_go": {"$ref": "#/definitions/_go_no_go"},
        "confidence": {"$ref": "#/definitions/_confidence"}
      }
    },
    "admet_cns_assessment": {
      "type": "object",
      "required": ["bbb_assessment", "toxicology_assessment", "pk_assessment", "go_no_go", "main_risks", "confidence"],
      "properties": {
        "go_no_go": {"$ref": "#/definitions/_go_no_go"},
        "confidence": {"$ref": "#/definitions/_confidence"}
      }
    },
    "docking_binding_interpretation": {
      "type": "object",
      "required": ["binding_interpretation", "reference_context", "admet_integration", "go_no_go", "validation_experiment", "confidence"],
      "properties": {
        "go_no_go": {"$ref": "#/definitions/_go_no_go"},
        "confidence": {"$ref": "#/definitions/_confidence"}
      }
    },
    "lead_optimization": {
      "type": "object",
      "required": ["optimization_goal", "liability_to_address", "proposed_modifications", "properties_to_recheck", "next_experiment", "confidence"],
      "properties": {
        "liability_to_address": {"type": "array"},
        "proposed_modifications": {"type": "array"},
        "properties_to_recheck": {"type": "array"},
        "confidence": {"$ref": "#/definitions/_confidence"}
      }
    },
    "repurposing_translatability": {
      "type": "object",
      "required": ["repurposing_rationale", "human_safety_dosing", "cns_exposure", "clinical_evidence_interpretation", "go_no_go", "confidence"],
      "properties": {
        "go_no_go": {"$ref": "#/definitions/_go_no_go"},
        "confidence": {"$ref": "#/definitions/_confidence"}
      }
    },
    "agentic_smiles_episode": {
      "type": "object",
      "required": ["mechanism_hypothesis", "evidence_table", "risk_assessment", "go_no_go", "decision_rationale", "next_experiment", "confidence"],
      "properties": {
        "evidence_table": {"type": "array"},
        "go_no_go": {"$ref": "#/definitions/_go_no_go"},
        "confidence": {"$ref": "#/definitions/_confidence"}
      }
    }
  }
}
